<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" alignment="CENTER" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.orm.controller.EstudianteController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <GridPane hgap="10" vgap="10">
        <Label text="Nombres:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtNombres" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Apellidos:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtApellidos" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Correo:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="txtCorreo" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Carrera:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <ComboBox fx:id="cmbCarrera" GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="150"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="btnGuardar" text="Guardar" onAction="#guardarEstudiante"/>
        <Button fx:id="btnConsultar" text="Consultar" onAction="#consultarEstudiantes"/>
    </HBox>

    <TableView fx:id="tablaEstudiantes" prefHeight="200" prefWidth="450">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="30"/>
            <TableColumn fx:id="colNombres" text="Nombres" prefWidth="100"/>
            <TableColumn fx:id="colApellidos" text="Apellidos" prefWidth="100"/>
            <TableColumn fx:id="colCorreo" text="Correo" prefWidth="120"/>
            <TableColumn fx:id="colCarrera" text="Carrera" prefWidth="100"/>
        </columns>
    </TableView>
</VBox>